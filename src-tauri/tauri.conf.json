{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exiles Atlas",
  "version": "0.1.0",
  "identifier": "dev.fernandomacedo.exilesatlas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "wix": {
        "upgradeCode": "a7d9a66b-0bf4-4b25-aab5-3c0bf6f68f9e",
        "language": "en-US"
      }
    }
  },
  "app": {
    "windows": [{
      "title": "Exiles Atlas",
      "width": 1280,
      "height": 800,
      "resizable": true
    }]
  }
}
